# Copy this file to .env.local (local) and add the same keys in Vercel → Settings → Environment Variables.

# resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Sender. Keep onboarding@resend.dev until hushlushtechnologies.com is verified in Resend,
# then change to e.g.  Hush Lush Website <website@hushlushtechnologies.com>
MAIL_FROM=Hush Lush Website <onboarding@resend.dev>

# Where submissions go (comma-separate for several inboxes).
# IMPORTANT: until the domain is verified, Resend only delivers to YOUR Resend account email,
# so put that address here while testing.
CAREERS_TO=careers@hushlushtechnologies.com
ENQUIRY_TO=marketing@hushlushtechnologies.com
